@page "/filedownloader"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Blazor_Serverside_Programming.Data

@inject FileInfoDbContext FileDb
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Download Files</PageTitle>

<h1>Download Files</h1>

@if (files is null)
{
    <p>Indlæser filer...</p>
}
else if (!files.Any())
{
    <p>Der er ingen filer til download.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Filnavn</th>
                <th>Størrelse</th>
                <th>Filtype</th>
                <th>Upload dato</th>
                <th>Handling</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in files)
            {
                <tr>
                    <td>@file.FileName</td>
                    <td>@file.FileSize bytes</td>
                    <td>@file.FileType</td>
                    <td>@file.UploadDate.ToLocalTime()</td>
                    <td>
                        <a class="btn btn-primary btn-sm"
                           href="/file-validation/@file.Id">
                            Validate & Download
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<FileRecord>? files;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (string.IsNullOrWhiteSpace(userName))
        {
            files = new();
            return;
        }

        files = await FileDb.Files
            .Where(f => f.UserName == userName)
            .OrderByDescending(f => f.UploadDate)
            .ToListAsync();
    }
}