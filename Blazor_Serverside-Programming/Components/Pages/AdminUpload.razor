@page "/admin/upload"
@attribute [Authorize(Roles = "Admin")]

@inject FileInfoDbContext FileDb
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IHashingService HashingService
@inject IDataProtectionProvider DataProtectionProvider

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.DataProtection
@using Blazor_Serverside_Programming.Data
@using Blazor_Serverside_Programming.Services
@using System.Security.Cryptography

<PageTitle>Admin Upload</PageTitle>

<h1>Admin Upload</h1>

<p>Kun admin-brugere kan se denne side.</p>

<div class="mb-3">
    <label class="form-label">Vælg bruger</label>

    <select class="form-select" @bind="selectedUserName">
        <option value="">-- Vælg bruger --</option>

        @foreach (var user in users)
        {
            <option value="@user.UserName">@user.UserName</option>
        }
    </select>
</div>

<InputFile OnChange="HandleFileSelected" />

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private string? message;
    private string selectedUserName = "";
    private List<ApplicationUser> users = new();

    protected override async Task OnInitializedAsync()
    {
        var allUsers = await UserManager.Users.ToListAsync();

        foreach (var user in allUsers)
        {
            if (!await UserManager.IsInRoleAsync(user, "Admin"))
            {
                users.Add(user);
            }
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(selectedUserName))
        {
            message = "Vælg en bruger før du uploader en fil.";
            return;
        }

        var file = e.File;

        var uploadFolder = Path.Combine(
            Directory.GetCurrentDirectory(),
            "Files",
            selectedUserName);

        Directory.CreateDirectory(uploadFolder);

        var filePath = Path.Combine(uploadFolder, file.Name);

        await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);

        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);

        var fileBytes = memoryStream.ToArray();

        await File.WriteAllBytesAsync(filePath, fileBytes);

        var verificationKeyBytes = RandomNumberGenerator.GetBytes(32);
        var verificationKey = Convert.ToBase64String(verificationKeyBytes);

        var protector = DataProtectionProvider
            .CreateProtector("FileVerificationKeyProtector");

        var protectedVerificationKey =
            protector.Protect(verificationKey);

        var verificationHash =
            HashingService.HmacSha256Hash(fileBytes, verificationKeyBytes);

        var record = new FileRecord
        {
            FileName = file.Name,
            FileType = file.ContentType,
            FilePath = filePath,
            FileSize = file.Size,
            UploadDate = DateTime.UtcNow,
            UserName = selectedUserName,

            VerificationHash = verificationHash,
            VerificationKey = protectedVerificationKey,
            HashAlgorithm = "HMAC-SHA256"
        };

        FileDb.Files.Add(record);
        await FileDb.SaveChangesAsync();

        message = $"Fil uploadet til {selectedUserName}: {file.Name}";
    }
}