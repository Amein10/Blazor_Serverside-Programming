@page "/transfer"

@using Microsoft.AspNetCore.Components.Forms
@using Blazor_FileTransferApp.Services
@using Blazor_FileTransferApp.Data
@using System.Net.Http.Json
@using System.Security.Cryptography

@inject IHttpClientFactory HttpClientFactory
@inject AesHandler AesHandler
@inject RsaClientHandler RsaClientHandler

<PageTitle>Fil overførsel app</PageTitle>

<h1>Fil overførsel app</h1>

<div class="mb-3">
    <label class="form-label">Vælg krypteringsmetode</label>

    <select class="form-select" @bind="selectedEncryptionMethod">
        <option value="Normal">AES/RSA normal</option>
        <option value="GCM">AES-GCM/RSA</option>
    </select>
</div>

<InputFile OnChange="HandleFileSelected" />

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    private string? message;
    private string selectedEncryptionMethod = "Normal";

    private const string ExpectedPublicKeyFingerprint =
        "CA29F3E1DF8E672707D539AF1FA328BC6E6D9A36BDC6CA8903482D10761BD6C9";

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        byte[]? fileBytes = null;
        byte[]? encryptedAesKey = null;

        try
        {
            var file = e.File;

            await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);

            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            fileBytes = memoryStream.ToArray();

            var client = HttpClientFactory.CreateClient();

            var publicKey = await client.GetStringAsync("https://localhost:7209/api/publickey");

            var publicKeyBytes = Convert.FromBase64String(publicKey);
            var publicKeyFingerprint = Convert.ToHexString(SHA256.HashData(publicKeyBytes));

            if (!CryptographicOperations.FixedTimeEquals(
                    Convert.FromHexString(publicKeyFingerprint),
                    Convert.FromHexString(ExpectedPublicKeyFingerprint)))
            {
                message = "Public key validation failed. Upload stopped.";
                return;
            }

            if (selectedEncryptionMethod == "GCM")
            {
                await SendWithAesGcmAsync(file, fileBytes, publicKey, client);
            }
            else
            {
                await SendWithNormalAesAsync(file, fileBytes, publicKey, client);
            }
        }
        finally
        {
            if (fileBytes is not null)
            {
                CryptographicOperations.ZeroMemory(fileBytes);
            }

            if (encryptedAesKey is not null)
            {
                CryptographicOperations.ZeroMemory(encryptedAesKey);
            }
        }
    }

    private async Task SendWithNormalAesAsync(
        IBrowserFile file,
        byte[] fileBytes,
        string publicKey,
        HttpClient client)
    {
        var aesResult = AesHandler.Encrypt(fileBytes);

        var encryptedAesKey = RsaClientHandler.EncryptWithPublicKey(
            aesResult.Key,
            publicKey);

        var request = new EncryptedFileUploadRequest
        {
            FileName = file.Name,
            FileType = file.ContentType,
            EncryptedFile = Convert.ToBase64String(aesResult.EncryptedBytes),
            EncryptedKey = Convert.ToBase64String(encryptedAesKey),
            IV = Convert.ToBase64String(aesResult.IV)
        };

        var response = await client.PostAsJsonAsync(
            "https://localhost:7209/api/upload-encrypted-file",
            request);

        if (response.IsSuccessStatusCode)
        {
            message = $"Filen blev krypteret og sendt med normal AES/RSA: {file.Name}";
        }
        else
        {
            message = $"Fejl ved upload: {response.StatusCode}";
        }

        CryptographicOperations.ZeroMemory(aesResult.Key);
        CryptographicOperations.ZeroMemory(aesResult.IV);
        CryptographicOperations.ZeroMemory(aesResult.EncryptedBytes);
        CryptographicOperations.ZeroMemory(encryptedAesKey);
    }

    private async Task SendWithAesGcmAsync(
        IBrowserFile file,
        byte[] fileBytes,
        string publicKey,
        HttpClient client)
    {
        var aesGcmResult = AesHandler.EncryptGcm(fileBytes);

        var encryptedAesKey = RsaClientHandler.EncryptWithPublicKey(
            aesGcmResult.Key,
            publicKey);

        var request = new EncryptedGcmFileUploadRequest
        {
            FileName = file.Name,
            FileType = file.ContentType,
            EncryptedFile = Convert.ToBase64String(aesGcmResult.EncryptedBytes),
            EncryptedKey = Convert.ToBase64String(encryptedAesKey),
            Nonce = Convert.ToBase64String(aesGcmResult.Nonce),
            Tag = Convert.ToBase64String(aesGcmResult.Tag)
        };

        var response = await client.PostAsJsonAsync(
            "https://localhost:7209/api/upload-encrypted-gcm-file",
            request);

        var responseText = await response.Content.ReadAsStringAsync();

        if (response.IsSuccessStatusCode)
        {
            message = $"Filen blev krypteret og sendt med AES-GCM/RSA: {file.Name}. Server: {responseText}";
        }
        else
        {
            message = $"Fejl ved AES-GCM upload: {response.StatusCode}. Server: {responseText}";
        }

        CryptographicOperations.ZeroMemory(aesGcmResult.Key);
        CryptographicOperations.ZeroMemory(aesGcmResult.Nonce);
        CryptographicOperations.ZeroMemory(aesGcmResult.Tag);
        CryptographicOperations.ZeroMemory(aesGcmResult.EncryptedBytes);
        CryptographicOperations.ZeroMemory(encryptedAesKey);
    }
}